{
  "name": "desafio-node",
  "version": "1.1.0",
  "main": "dist/shared/infra/http/server.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/shared/infra/http/server.js",
    "dev:server": "ts-node-dev -r tsconfig-paths/register -r dotenv/config --transpile-only --ignore-watch node_modules src/shared/infra/http/server.ts",
    "typeorm": "ts-node -r tsconfig-paths/register -r dotenv/config ./node_modules/typeorm/cli.js -d src/shared/infra/typeorm/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:all": "npm test && npm run test:e2e"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "celebrate": "^15.0.3",
    "class-transformer": "^0.5.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "express": "^4.22.3",
    "express-async-errors": "^3.1.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "remove-accents": "^0.5.0",
    "tsyringe": "^4.10.0",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "dotenv": "^16.6.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.7",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
